// hand-written, not generated by pySigma.
// rule: erp_vendor_created_and_payment_approved_by_same_user
// id: e61a55ef-585a-4b7e-bc43-f0558626f3d5
// sigma: temporal (unordered), timespan 30d, group-by vendor_id, user
// referenced rules: erp_sod_vendor_created_event, erp_sod_payment_approved_event
// assumed tables: sigmafin_erp_vendor_master, sigmafin_erp_payments
// assumed fields: action, status, vendor_id, user, TimeGenerated
// TimeGenerated must be the Sigma timestamp.
// This is a sliding window. The generated SPL bins time and can miss a pair
// that crosses a bin edge (docs/splunk-expectations.md). Do not copy that bin.
// Keep in sync with the Sigma rule. See docs/handwritten-correlations.md.
let creates = sigmafin_erp_vendor_master
| where action == "vendor_created" and status == "success"
| project vendor_id, user, create_time = TimeGenerated;
let approvals = sigmafin_erp_payments
| where action == "payment_approved" and status == "success"
| project vendor_id, user, approve_time = TimeGenerated;
creates
| join kind=inner approvals on vendor_id, user
| where abs(approve_time - create_time) between (0min .. 30d)
| extend sigma_timespan = "30d", detection_origin = "hand-written"
