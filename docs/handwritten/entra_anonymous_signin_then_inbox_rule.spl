# hand-written, not generated by pySigma.
# rule: entra_anonymous_signin_then_inbox_rule
# id: c3f8a1d6-2e59-4b70-8a4c-6d0e9b7f1235
# sigma: temporal_ordered, timespan 1h, group-by user
# referenced rules: entra_finance_anonymous_signin_event, m365_inbox_rule_change_event
# alias user: UserPrincipalName on the sign-in, UserId on the audit event
# assumed sourcetypes: sigmafin:entra:signinlogs, o365:management:activity
# assumed fields: UserPrincipalName, ResultType, RiskEventTypes_V2, Operation, UserId
# finance users below are the synthetic finance_users list in pipelines/finance_scope.yml
# _time must be the Sigma timestamp.
# Keep in sync with the Sigma rule. See docs/handwritten-correlations.md.

sourcetype="sigmafin:entra:signinlogs" ResultType=0 RiskEventTypes_V2="*anonymizedIPAddress*"
  (UserPrincipalName="ap.clerk@finance.example.com" OR UserPrincipalName="treasury.analyst@finance.example.com" OR UserPrincipalName="payroll.lead@finance.example.com" OR UserPrincipalName="alice.ledger@finance.example.com")
| rename _time AS signin_time, UserPrincipalName AS user
| fields user signin_time
| join user type=inner max=0
  [
    search sourcetype="o365:management:activity" (Operation="New-InboxRule" OR Operation="Set-InboxRule")
    | rename _time AS rule_time, UserId AS user
    | fields user rule_time
  ]
| where rule_time > signin_time AND (rule_time - signin_time) <= 60*60
| eval sigma_timespan="1h"
| eval detection_origin="hand-written"
