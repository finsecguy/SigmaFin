// hand-written, not generated by pySigma.
// rule: erp_vendor_bank_change_then_payment
// id: 6a1f4c8e-0b25-4e93-a7d3-9c2b5e8f1a64
// sigma: temporal_ordered, timespan 3d, group-by vendor_id
// referenced rules: erp_vendor_bank_change_event, erp_vendor_payment_released
// assumed tables: sigmafin_erp_vendor_master, sigmafin_erp_payments
// assumed fields: action, status, field_changed, vendor_id, TimeGenerated
// TimeGenerated must be the Sigma timestamp.
// Keep in sync with the Sigma rule. See docs/handwritten-correlations.md.
let changes = sigmafin_erp_vendor_master
| where action == "vendor_updated" and status == "success"
    and field_changed in (
        "bank_account_number",
        "iban",
        "bank_routing_number",
        "swift_bic",
        "bank_name",
        "bank_country"
    )
| project vendor_id, change_time = TimeGenerated;
let payments = sigmafin_erp_payments
| where action == "payment_released" and status == "success"
| project vendor_id, pay_time = TimeGenerated;
changes
| join kind=inner payments on vendor_id
| where pay_time > change_time and pay_time - change_time between (0min .. 3d)
| extend sigma_timespan = "3d", detection_origin = "hand-written"
