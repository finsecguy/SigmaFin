// hand-written, not generated by pySigma.
// rule: entra_anonymous_signin_then_inbox_rule
// id: c3f8a1d6-2e59-4b70-8a4c-6d0e9b7f1235
// sigma: temporal_ordered, timespan 1h, group-by user
// referenced rules: entra_finance_anonymous_signin_event, m365_inbox_rule_change_event
// alias user: UserPrincipalName on the sign-in, UserId on the audit event
// assumed tables: SigninLogs, OfficeActivity
// assumed fields: UserPrincipalName, ResultType, RiskEventTypes_V2, Operation, UserId, TimeGenerated
// finance users below are the synthetic finance_users list in pipelines/finance_scope.yml
// TimeGenerated must be the Sigma timestamp.
// Keep in sync with the Sigma rule. See docs/handwritten-correlations.md.
let signins = SigninLogs
| where ResultType == 0
    and RiskEventTypes_V2 contains "anonymizedIPAddress"
    and UserPrincipalName in (
        "ap.clerk@finance.example.com",
        "treasury.analyst@finance.example.com",
        "payroll.lead@finance.example.com",
        "alice.ledger@finance.example.com"
    )
| project user = UserPrincipalName, signin_time = TimeGenerated;
let rules = OfficeActivity
| where Operation in ("New-InboxRule", "Set-InboxRule")
| project user = UserId, rule_time = TimeGenerated;
signins
| join kind=inner rules on user
| where rule_time > signin_time and rule_time - signin_time between (0min .. 1h)
| extend sigma_timespan = "1h", detection_origin = "hand-written"
