# hand-written, not generated by pySigma.
# rule: erp_vendor_bank_change_then_payment
# id: 6a1f4c8e-0b25-4e93-a7d3-9c2b5e8f1a64
# sigma: temporal_ordered, timespan 3d, group-by vendor_id
# referenced rules: erp_vendor_bank_change_event, erp_vendor_payment_released
# assumed sourcetypes: sigmafin:erp:vendor_master, sigmafin:erp:payments
# assumed fields: action, status, field_changed, vendor_id
# _time must be the Sigma timestamp.
# Keep in sync with the Sigma rule. See docs/handwritten-correlations.md.

sourcetype="sigmafin:erp:vendor_master" action="vendor_updated" status="success"
  (field_changed="bank_account_number" OR field_changed="iban" OR field_changed="bank_routing_number" OR field_changed="swift_bic" OR field_changed="bank_name" OR field_changed="bank_country")
| rename _time AS change_time
| fields vendor_id change_time
| join vendor_id type=inner max=0
  [
    search sourcetype="sigmafin:erp:payments" action="payment_released" status="success"
    | rename _time AS pay_time
    | fields vendor_id pay_time
  ]
| where pay_time > change_time AND (pay_time - change_time) <= 3*24*60*60
| eval sigma_timespan="3d"
| eval detection_origin="hand-written"
